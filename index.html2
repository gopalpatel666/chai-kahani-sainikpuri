*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#faf7f2;
color:#333;
}

header{
background:#5a3e2b;
color:white;
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
font-size:24px;
font-weight:600;
}

nav a{
color:white;
margin-left:20px;
text-decoration:none;
}

.hero{
height:80vh;
background:url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb') center/cover;
